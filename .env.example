# Postgres. On Render this comes from the database via render.yaml.
# For an external connection add ?sslmode=require to the URL.
DATABASE_URL=postgres://localhost:5432/ode
PORT=3000

# PayPal sandbox (developer.paypal.com -> Apps & Credentials -> Sandbox -> ode)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox
# Developer dashboard -> the app -> Webhooks -> the webhook's ID
# URL to subscribe to PAYMENT.CAPTURE.COMPLETED: https://<your-host>/api/payments/webhook
PAYPAL_WEBHOOK_ID=
# The sandbox Personal account that pays each friend, as Name=email pairs matching the ledger's names
FRIEND_PAYPAL_ACCOUNTS=Tharun=<sandbox email>,Vikram=<sandbox email>,Sahiti=<sandbox email>

# Anthropic (console.anthropic.com)
ANTHROPIC_API_KEY=

# ElevenLabs (elevenlabs.io; Music needs a paid plan)
# On Render only the Workflow task needs this; locally the web service makes the Ode itself.
ELEVENLABS_API_KEY=

# The Ode is made by a Render Workflow task. Leave both empty off Render to make it inside the web service.
# On Render, render.yaml sets the slug and you set the key (dashboard.render.com/u/settings -> API Keys).
RENDER_API_KEY=
ODE_WORKFLOW_SLUG=
# The payer's cloned voice, used only by `npm run seed:voice` to convert the Seeded Ode (ADR 0002). That command also reads
# `.env.seed` after `.env`: put the hosted database's external DATABASE_URL (with ?sslmode=require) there, so it never touches your local one.
ELEVENLABS_VOICE_ID=
# What the page says of the Seeded Ode's converted voice: unset is "in my voice"; `like` is "a voice like mine" (if the H3 test says the clone is not recognised)
VOICE_LABEL=
