{
  "name": "ode",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev:server": "node --env-file-if-exists=.env --watch src/server/main.ts",
    "dev:client": "vite",
    "dev:fake": "vite build && node src/testing/dev-fake.ts",
    "prepare": "git config core.hooksPath .githooks || true",
    "build": "vite build",
    "start": "node --env-file-if-exists=.env src/server/main.ts",
    "reliability": "node --env-file-if-exists=.env scripts/reliability.ts",
    "seed:ode": "node --env-file-if-exists=.env scripts/seed-ode.ts",
    "typecheck": "tsc --noEmit",
    "check": "tsc --noEmit && node scripts/check-casts.ts && node scripts/check-imports.ts",
    "seed:voice": "node --env-file-if-exists=.env --env-file-if-exists=.env.seed scripts/seed-voice.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.6.0",
    "@hono/node-server": "^2.1.6",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "@renderinc/sdk": "^1.8.0",
    "hono": "^4.13.17",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.15",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^6.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.7",
    "vitest": "^5.1.0"
  }
}
